{
  "name": "looptv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "wrangler pages dev dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "astro check",
    "build:catalog": "bash scripts/fetch-sources.sh && bash scripts/build-catalog.sh --process-only",
    "audit:catalog": "node scripts/audit-catalog-health.mjs",
    "audit:catalog:full": "node scripts/full-catalog-rebaseline.mjs",
    "seed:local": "bash scripts/seed-local.sh",
    "build:ner": "python3 scripts/extract-tags.py",
    "fetch:all": "bash scripts/fetch-all-sources.sh",
    "cf:build": "pnpm build",
    "deploy": "pnpm cf:build && wrangler pages deploy dist --project-name=looptv",
    "docs:check": "node scripts/validate-docs.mjs",
    "docs:check:strict": "node scripts/validate-docs.mjs --strict",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols",
    "quality:unused": "node scripts/check-code-health.mjs unused",
    "quality:complexity": "node scripts/check-code-health.mjs complexity",
    "quality:duplication": "node scripts/check-code-health.mjs duplication",
    "quality:cycles": "node scripts/check-code-health.mjs cycles",
    "quality:dependencies": "node scripts/check-code-health.mjs dependencies",
    "quality:suppressions": "node scripts/check-code-health.mjs suppressions",
    "quality:hygiene": "node scripts/check-code-health.mjs hygiene",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm quality:unused && pnpm quality:complexity && pnpm quality:duplication && pnpm quality:cycles && pnpm quality:dependencies && pnpm quality:suppressions && pnpm docs:check && pnpm build && pnpm quality:hygiene"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@saas-maker/feedback": "^0.2.1",
    "ai": "6.0.168",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.4.2",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@types/youtube": "0.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "astro": "^5.16.6",
    "jscpd": "5.0.14",
    "knip": "^6.29.0",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "ultracite": "7.10.2",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "dompurify@<=3.4.12": "3.4.13",
      "fast-uri@<3.1.5": "3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "sharp@<0.35.0": "0.35.3",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
