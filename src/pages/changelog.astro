---
import BaseLayout from '@/layouts/BaseLayout.astro';

const repository = 'https://github.com/Significant-Hobbies/looptv';
const releases = [
  {
    date: '2026-07-25',
    title: 'A lighter, fully static LoopTV',
    outcomes: [
      'The production site moved to an Astro shell with React only where playback needs browser state.',
      'Stations, permalinks, catalog assets, random play, and the TV-style experience stayed intact.',
    ],
  },
  {
    date: '2026-07-17',
    title: 'Clearer catalog discovery',
    outcomes: [
      'The public catalog gained a station breakdown and structured video metadata.',
      'Canonical metadata, sitemaps, robots guidance, and the owned tv.significanthobbies.com address were reverified.',
    ],
  },
  {
    date: '2026-07-12',
    title: 'Safer catalog refreshes',
    outcomes: [
      'Quota-aware refreshes reuse recent source data and stop before unnecessary YouTube API work.',
      'Integrity checks now block suspiciously small, stale, or incomplete catalogs from shipping.',
    ],
  },
  {
    date: '2026-04-04',
    title: 'LoopTV launched',
    outcomes: [
      'Curated YouTube channels became lean-back stations with random continuous playback.',
      'Watch history and preferences remain on the device, with no account or runtime API key.',
    ],
  },
];
---

<BaseLayout
  title="Changelog"
  description="Meaningful improvements to LoopTV playback, catalog quality, and reliability."
  canonicalPath="/changelog"
>
  <main class="mx-auto min-h-screen w-full max-w-4xl px-5 py-12 text-zinc-100 sm:px-8 sm:py-16">
    <a class="text-sm font-semibold text-red-400 hover:text-red-300" href="/">LoopTV</a>
    <header class="mt-10 max-w-2xl">
      <p class="text-sm font-semibold text-red-400">Product history</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-white sm:text-5xl">Changelog</h1>
      <p class="mt-4 max-w-[65ch] leading-7 text-zinc-400">
        Meaningful improvements to the lean-back player, curated catalog, and refresh pipeline.
      </p>
      <nav class="mt-6 flex flex-wrap gap-5 text-sm" aria-label="Project links">
        <a class="text-red-400 hover:text-red-300" href={`${repository}/issues`}>Roadmap</a>
        <a class="text-red-400 hover:text-red-300" href={repository}>Source</a>
      </nav>
    </header>

    <ol class="mt-12 space-y-5">
      {
        releases.map((release) => (
          <li>
            <article class="rounded-xl bg-zinc-900 p-5 sm:p-7">
              <time class="text-xs font-semibold text-zinc-500" datetime={release.date}>
                {new Date(`${release.date}T00:00:00`).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h2 class="mt-2 text-xl font-semibold text-white">{release.title}</h2>
              <ul class="mt-4 list-disc space-y-2 pl-5 leading-7 text-zinc-400">
                {release.outcomes.map((outcome) => <li>{outcome}</li>)}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
