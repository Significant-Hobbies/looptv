---
import { StudioFooter } from '@saas-maker/ui/blocks/footer';
import home from '@/content/home.json';
import { footerProps } from '@/components/studio-footer';
const tokens = Object.entries(home.page.tokens).map(([key, value]) => `${key}:${value}`).join(';');
---

<studio-footer data-theme="gallery" data-mode="dark" style={tokens}>
  <StudioFooter {...footerProps} />
</studio-footer>
<script>
  import '@saas-maker/ui/footer.js';
</script>
