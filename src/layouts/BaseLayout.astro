---
import StudioFooter from '@/components/StudioFooter.astro';
import ClientServices from '@/components/ClientServices';
import { canonicalPublicUrl, PUBLIC_ORIGIN, LOCAL_USER_PATHS, PUBLIC_SURFACES } from '@/lib/public-surfaces';
import '@/styles/global.css';
import home from '@/content/home.json';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = 'LoopTV',
  description = 'Pick a station. Random clips from curated YouTube channels play nonstop. No account, no algorithm.',
  canonicalPath = '/',
  noindex = false,
} = Astro.props;
const isPublic = !noindex && !LOCAL_USER_PATHS.includes(canonicalPath.replace(/\/$/, ''));
const aiSummary = PUBLIC_SURFACES.find((surface) => surface.path === canonicalPath.replace(/\/$/, ''))?.summary ?? description;
const siteUrl = PUBLIC_ORIGIN;
const canonical = canonicalPublicUrl(canonicalPath);
const pageTitle = title.startsWith('LoopTV') ? title : `${title} | LoopTV`;
const jsonLd = home.page.jsonLd;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta name="robots" content={isPublic ? "index, follow" : "noindex, follow"} />
    {isPublic && <meta name="ai-summary" content={aiSummary} />}
    {isPublic && <link rel="alternate" type="text/markdown" href={`${siteUrl}${canonicalPath === "/" ? "/index" : canonicalPath.replace(/\/$/, "")}.md`} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LoopTV" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script is:inline>
      (function(c,l,a,r,i){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        var done=0,ev=["pointerdown","keydown","touchstart","scroll"];
        function go(){
          if(done)return;done=1;
          clearTimeout(timer);
          ev.forEach(function(e){removeEventListener(e,go)});
          var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        }
        ev.forEach(function(e){addEventListener(e,go,{passive:true,once:true})});
        var timer=setTimeout(go,90000);
      })(window,document,"clarity","script","y6bubc8t38");
      window.clarity("set","project_id","looptv");
    </script>
  <script is:inline src="/app-health-log.js" defer></script>
</head>
  <body class="bg-black">
    <script is:inline>
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const name = event.target.closest('[data-app-health-event]')?.getAttribute('data-app-health-event');
        if (!name) return;
        try {
          const tracker = window.appHealth;
          tracker?.track?.(name);
          queueMicrotask(() => void tracker?.flush?.().catch(() => undefined));
        } catch {
          // Tracking must not interfere with navigation.
        }
      });
    </script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_86d522d6796f1dfa8d87eed28f9ef1c93b37083cb0d15cdbc30811408eb00390"
      data-project="app-import-1b0d7392ffccff32742c0135336a1c178561bdd917e74b2623e02a6947d7da10"
      data-identity="persistent"
      data-vitals
    ></script>
    <slot />
    <ClientServices client:idle />
    <StudioFooter />
  </body>
</html>
