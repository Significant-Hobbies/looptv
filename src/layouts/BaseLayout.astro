---
import ClientServices from '@/components/ClientServices';
import { canonicalPublicUrl, PUBLIC_ORIGIN } from '@/lib/public-surfaces';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  showProjectStrip?: boolean;
  showPreciseFooter?: boolean;
}

const {
  title = 'LoopTV',
  description = 'Pick a station. Random clips from curated YouTube channels play nonstop. No account, no algorithm.',
  canonicalPath = '/',
  showProjectStrip = true,
  showPreciseFooter = true,
} = Astro.props;
const siteUrl = PUBLIC_ORIGIN;
const canonical = canonicalPublicUrl(canonicalPath);
const pageTitle = title.startsWith('LoopTV') ? title : `${title} | LoopTV`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sassmaker.com/#org',
      name: 'SaaS Maker (Foundry)',
      url: 'https://sassmaker.com',
      sameAs: ['https://sassmaker.com', 'https://github.com/Significant-Hobbies/looptv'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'sarthakagrawal@agentmail.to',
        url: 'https://tv.significanthobbies.com',
      },
      address: { '@type': 'PostalAddress', addressCountry: 'US' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#app`,
      name: 'LoopTV',
      url: siteUrl,
      description: 'TV-style random video player for lean-back browsing of curated channels.',
      publisher: { '@id': 'https://sassmaker.com/#org' },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LoopTV" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script is:inline>
      (function(c,l,a,r,i){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        var done=0,ev=["pointerdown","keydown","touchstart","scroll"];
        function go(){
          if(done)return;done=1;
          clearTimeout(timer);
          ev.forEach(function(e){removeEventListener(e,go)});
          var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        }
        ev.forEach(function(e){addEventListener(e,go,{passive:true,once:true})});
        var timer=setTimeout(go,90000);
      })(window,document,"clarity","script","y6bubc8t38");
      window.clarity("set","project_id","looptv");
    </script>
  <!-- fleet-jsonld:start (generated by apply-agent-surfaces; edit registry, not this) -->
<script is:inline type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://sarthakagrawal.dev/#person","name":"Sarthak Agrawal","jobTitle":"AI Infrastructure & Product Engineer","url":"https://sarthakagrawal.dev","image":"https://avatars.githubusercontent.com/u/43884471?v=4","sameAs":["https://sarthakagrawal.dev","https://www.linkedin.com/in/sarthakagrawal927","https://github.com/sarthakagrawal927","https://x.com/sarthakcodes","https://huggingface.co/sarthakagrawal927"],"knowsAbout":["AI infrastructure","Local-first software","Post-training language models","AI code review","Cloudflare Workers","TypeScript","Rust"],"affiliation":{"@type":"Organization","@id":"https://sassmaker.com/#app","name":"SaaS Maker","url":"https://sassmaker.com"}},{"@type":"WebSite","@id":"https://tv.significanthobbies.com/#app","name":"LoopTV","url":"https://tv.significanthobbies.com","description":"TV-style random video player for lean-back browsing of curated channels.","publisher":{"@id":"https://sarthakagrawal.dev/#person"},"sameAs":["https://github.com/Significant-Hobbies/looptv"]}]}</script>
<!-- fleet-jsonld:end -->
  <script is:inline src="/app-health-log.js" defer></script>
</head>
  <body class="bg-black">
    <script is:inline>
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const name = event.target.closest('[data-app-health-event]')?.getAttribute('data-app-health-event');
        if (!name) return;
        try {
          const tracker = window.appHealth;
          tracker?.track?.(name);
          queueMicrotask(() => void tracker?.flush?.().catch(() => undefined));
        } catch {
          // Tracking must not interfere with navigation.
        }
      });
    </script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_86d522d6796f1dfa8d87eed28f9ef1c93b37083cb0d15cdbc30811408eb00390"
      data-project="app-import-1b0d7392ffccff32742c0135336a1c178561bdd917e74b2623e02a6947d7da10"
      data-identity="persistent"
    ></script>
    <slot />
    <ClientServices client:idle />
    {showPreciseFooter ? (
      <footer class="looptv-precise-footer" aria-label="LoopTV footer">
        <fleet-footer-extension
          data-fleet-footer-project="looptv"
          product-name="LoopTV"
          theme="dark"
          surface="app"
          signature-font="ui"
          font-base="/fonts/fleet-footer-precise-v1/"
          art-src="/footer-art/looptv.webp"
          art-alt="LoopTV: A calm lean-back screening nook centers one comfortable chair facing a fictional abstract screen. A simple channel selector, unbranded reels and an empty alternate slot show deliberate simplicity and unavailable content without drama."
          art-width="2169"
          art-height="725"
          art-position="50% 50%"
          art-credit="Original illustration for LoopTV"
        >
          <nav slot="navigation" aria-label="LoopTV footer navigation">
            <div>
              <h2 data-fleet-footer-group-label>Watch</h2>
              <a data-fleet-footer-primary href="/">Home</a>
              <a href="/channels">Browse stations</a>
            </div>
            <div>
              <h2 data-fleet-footer-group-label>LoopTV</h2>
              <a href="/about">About</a>
              <a href="/changelog">Changelog</a>
            </div>
            <div>
              <h2 data-fleet-footer-group-label>Legal</h2>
              <a data-fleet-footer-legal href="/privacy">Privacy</a>
              <a data-fleet-footer-legal href="/terms">Terms</a>
            </div>
          </nav>
          <saas-maker-newsletter-capture
            slot="capture"
            product-name="LoopTV"
            catalog-id="looptv"
            kind="newsletter"
            source="footer"
            privacy-url="https://tv.significanthobbies.com/privacy"
            theme="dark"
            layout="compact"
            integrated
          ></saas-maker-newsletter-capture>
        </fleet-footer-extension>
        <script is:inline type="module" src="https://sassmaker.com/newsletter-capture.js?v=precise-b0adaa67"></script>
        {showProjectStrip && (
          <script
            is:inline
            defer
            src="https://sassmaker.com/project-strip.js?v=precise-b0adaa67"
            data-project="looptv"
            data-theme="dark"
            data-layout="studio"
            data-host-only="true"
          ></script>
        )}
        <script
          is:inline
          defer
          src="https://sassmaker.com/ai-chat-footer.js?v=precise-b0adaa67"
          data-name="LoopTV"
          data-project="looptv"
          data-theme="dark"
          data-surface="app"
          data-layout="question"
          data-host-only="true"
          data-capture="false"
        ></script>
      </footer>
    ) : (
      <>
        <saas-maker-newsletter-capture
          product-name="LoopTV"
          catalog-id="looptv"
          kind="newsletter"
          source="footer"
          privacy-url="https://tv.significanthobbies.com/privacy"
          theme="dark"
        ></saas-maker-newsletter-capture>
        <script is:inline type="module" src="https://sassmaker.com/newsletter-capture.js"></script>
        {showProjectStrip && (
          <script
            is:inline
            src="https://sassmaker.com/project-strip.js"
            data-project="looptv"
            defer
          ></script>
        )}
        <script
          is:inline
          src="https://sassmaker.com/ai-chat-footer.js"
          data-name="LoopTV"
          defer
        ></script>
      </>
    )}
    <script is:inline>
      // The shared capture widget hard-codes a "you@example.com" placeholder; replace it
      // with a neutral label so no sample address renders.
      customElements.whenDefined('saas-maker-newsletter-capture').then(function () {
        var el = document.querySelector('saas-maker-newsletter-capture');
        var root = el && el.shadowRoot;
        if (!root) return;
        var fix = function () {
          var input = root.querySelector('input[type="email"]');
          if (input && input.placeholder === 'you@example.com') input.placeholder = 'Email address';
        };
        fix();
        new MutationObserver(fix).observe(root, { childList: true, subtree: true });
      });
    </script>
  </body>
</html>

<style is:global>
  .looptv-precise-footer {
    width: 100%;
    margin: 0;
    padding: 0;
    color: var(--foreground);
    background: var(--background);
    font-family: "Montserrat", sans-serif;
    --fleet-footer-canvas: #0a0a0a;
    --fleet-footer-lower: #0a0a0a;
    --fleet-footer-edge: clamp(1.25rem, 4vw, 3rem);
    --fleet-footer-max-width: 82rem;
    --fleet-footer-app-art-height: clamp(20rem, 26vw, 28rem);
    --fleet-footer-app-mobile-art-height: 20rem;
  }

  .looptv-precise-footer [slot="navigation"] > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.25rem;
    column-gap: 0.75rem;
  }

  .looptv-precise-footer [slot="navigation"] [data-fleet-footer-group-label] {
    flex-basis: 100%;
  }
</style>
