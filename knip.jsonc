{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.{astro,ts}",
    "scripts/*.mjs",
    "astro.config.ts",
    "vitest.config.ts",
    "functions/**/*.ts"
  ],
  "project": ["**/*.{astro,ts,tsx,js,jsx,mjs,cjs,mts}"],
  "ignore": [
    // Optional docs presentation config and the runtime-copied yt-dlp boundary.
    // Static asset loaded via a raw <script src> tag (BaseLayout.astro), not an import.
    "public/app-health-log.js",
    // Reviewed immutable native footer bundle, loaded by StudioFooter.astro.
    "public/studio-footer/14712fdf/footer.js"
  ],
  "ignoreDependencies": [
    // CSS-only dependency and the checker-spawned CLI are not visible in the import graph.
    "jscpd",
    "tailwindcss"
  ],
  "ignoreBinaries": ["yt-dlp"]
}
